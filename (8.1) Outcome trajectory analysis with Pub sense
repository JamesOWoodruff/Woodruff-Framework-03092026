         asr_anx_long = mh_p_asr__dsm__anx_sum)

# Puberty score: time-varying, sex-appropriate PDS categorical (Tanner 1-5)
pds_long <- Cov %>%
  filter(session_id %in% annual_sessions) %>%
  select(participant_id, session_id,
         ab_g_stc__cohort_sex,
         ph_p_pds__f_categ,
         ph_p_pds__m_categ) %>%
  mutate(
    ph_p_pds__f_categ = na_if(as.numeric(ph_p_pds__f_categ), 999),
    ph_p_pds__f_categ = na_if(ph_p_pds__f_categ, 777),
    ph_p_pds__m_categ = na_if(as.numeric(ph_p_pds__m_categ), 999),
    ph_p_pds__m_categ = na_if(ph_p_pds__m_categ, 777),
    puberty_score_long = case_when(
      ab_g_stc__cohort_sex == 2 ~ ph_p_pds__f_categ,
      ab_g_stc__cohort_sex == 1 ~ ph_p_pds__m_categ,
